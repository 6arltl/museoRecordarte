<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Museo RecordArte</title>
  <meta name="description" content="Un proyecto transmedia sobre el CPM, la memoria y el arte">
  <link rel="stylesheet" href="style.css" />
  <link rel="stylesheet" href="fonts.css" />
  <link rel="stylesheet" href="style_new.css" />
</head>

<body data-pack="caramel">

  <header class="mast">
    <div class="wrap">
      <div class="inline">
        <img src="/favicon.png" class="logo" />
        <a class="brand" href="#top">Museo Recordarte</a>
      </div>
      <nav class="mnav" aria-label="Main">
        <!-- <a href="#menu">Menu</a> -->
        <!-- <a href="#story">Our story</a> -->
        <!-- <a href="#visit">Find us</a> -->
      </nav>
      <div class="mast-right">
        <!-- <span class="statuschip js-status"><span class="led"></span><span class="js-status-text">Checking the -->
        <!--     door</span></span> -->
        <!-- <a class="btn mbtn" href="#visit"></a> -->
      </div>
    </div>
  </header>

  <!-- hero + ticker pinned together to fill 100svh below the header -->
  <div class="hero-wrap" id="top">
    <section class="hero">
      <div class="hero-img"><img src="torta.jpg" alt="The cafe room, people at the tables under warm pendant lights"
          fetchpriority="high"></div>
      <div class="wrap">
        <h1>Memoria, Verdad y Justicia</h1>
        <p class="h-sub">Mira estas obras de arte censuradas</p>
        <div class="h-cta">
          <a class="btn hbtn" href="#menu">Ver las obras</a>
          <!-- <a class="btn ghost" href="#visit">Find us</a> -->
        </div>
      </div>
    </section>

    <!-- live counter strip, pinned to bottom of the 100svh hero-wrap -->
    <div class="fold" aria-label="On the counter right now">
      <span class="tick" id="tick"><b></b></span>
    </div>
  </div>

  <!-- the counter through the day -->
  <section class="tiles" id="menu">
    <div class="wrap">
      <div class="t-head">
        <h2>Nuestras expansiones</h2>
      </div>
      <div class="t-grid">
        <div class="tile big">
          <div class="ph"><img src="torta.jpg" alt="Croissants fresh on the baking tray"></div>
          <h3>Entrevistas</h3>
          <p>Visita nuestras entrevistas a artistas y gente del ámbito para informarte más!</p>
        </div>
        <div class="t-col">
          <div class="tile">
            <div class="ph"><img src="torta.jpg" alt="A filled baguette sandwich on a plate"></div>
            <h3>Sala de las Ausencias</h3>
            <p>Encuentra las fechas donde esté esta experiencia inmersiva y real con una gran reflexión y ambientación
            </p>
          </div>
          <div class="tile">
            <div class="ph"><img src="torta.jpg" alt="A slice of cake and a flat white by the window">
            </div>
            <h3>Sala de Obras</h3>
            <p>Visita nuestro acerbo digital donde digitalizamos y hacemos accesibles las obras de arte para el público
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- story tease -->
  <!-- <section class="inside" id="story"> -->
  <!--   <div class="wrap"> -->
  <!--     <div class="in-feature"> -->
  <!--       <div class="ph"><img src="img/tease-story.jpg" alt="Cafe interior with warm hanging bulbs and timber counter"> -->
  <!--       </div> -->
  <!--       <div class="tx"> -->
  <!--         <h3>The old newsagent at number three</h3> -->
  <!--         <p>This shop sold Redbrook's papers for forty years. We kept the rack by the door and put two ovens in the -->
  <!--           back. Coffee comes from Pilot Works across town, pastry is baked here every morning.</p> -->
  <!--       </div> -->
  <!--     </div> -->
  <!--   </div> -->
  <!-- </section> -->
  <!---->
  <!-- find us : hours + contact -->
  <section class="v-main" id="visit">
    <div class="wrap v-grid">
      <figure class="v-fig">
        <div class="ph"><img src="torta.jpg" alt="The cafe on its street corner, people at the pavement tables"></div>
      </figure>
      <div>
        <div class="hoursboard">
          <h2>Sala de las Ausencias</h2>
          <p class="hb-now js-open-msg">Fechas y Horarios</p>
          <div class="hgroup" data-days="1,2,3,4,5"><span class="hd">Lunes 30 de Octubre, Facultad de Artes, Diseño y
              Ciencias de la Cultura</span><span class="ht">7:00 a
              16:00</span></div>
          <div class="hgroup" data-days="6"><span class="hd">...</span><span class="ht">8:00 a 16:00</span></div>
          <div class="hgroup" data-days="0"><span class="hd">...</span><span class="ht">8:00 a 14:00</span></div>
        </div>
        <div class="particulars">
          <div class="pt">
            <h3>Lugar</h3>
            <p><small>Facultad de Arte, Diseño y Ciencias de la Cultura Av. Castelli Google Maps poner después</small>
            </p>
          </div>
          <div class="pt">
            <h3>Número de Contacto</h3>
            <p><a href="tel:+3794049362">3794049362</a><small></small></p>
          </div>
          <div class="pt">
            <h3>Correo de Contacto</h3>
            <p><a href="mailto:hola@gmail.com">museorecordarte@gmail.com</a><small></small></p>
          </div>
        </div>
        <a class="btn" href="https://www.google.com/maps/search/?api=1&query=3+Chandler+Street+Redbrook+RB1+4EN"
          target="_blank" rel="noopener">Ver más <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.6" aria-hidden="true">
            <path d="M7 17L17 7M9 7h8v8" />
          </svg></a>
      </div>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <p class="fbrand">Recordarte</p>
          <p class="fabout">Un proyecto transmedia sobre el CPM, la memoria y el arte</p>
        </div>
        <div>
          <h4>En esta página</h4>
          <ul>
            <!-- <li><a href="#menu">Menu</a></li> -->
            <!-- <li><a href="#story">Our story</a></li> -->
            <!-- <li><a href="#visit">Find us</a></li> -->
          </ul>
        </div>
        <div>
          <h4>Contactos</h4>
          <!-- <p class="fvisit"><b>3 Chandler Street</b><br>Redbrook RB1 4EN<br> -->
          <a href="tel:+12345678">123456789</a><br>
          <a href="mailto:hola@ejemplo.com">museorecordarte@gmail.com</a><br>
          <!-- <span class="js-open-msg">Open seven days</span> -->
          </p>
        </div>
      </div>
      <div class="foot-bot">
        <span>&copy; Chandler Street Coffee 2026</span>
      </div>
    </div>
  </footer>

  <script src="lenis.min.js"></script>
  <script src="site.js"></script>
</body>

</html>
